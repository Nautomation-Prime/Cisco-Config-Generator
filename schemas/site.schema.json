{
  "$defs": {
    "ACLEntry": {
      "additionalProperties": false,
      "properties": {
        "acl_name": {
          "title": "Acl Name",
          "type": "string"
        },
        "action": {
          "default": "",
          "enum": [
            "permit",
            "deny",
            ""
          ],
          "title": "Action",
          "type": "string"
        },
        "network": {
          "default": "",
          "title": "Network",
          "type": "string"
        },
        "remark": {
          "default": "",
          "title": "Remark",
          "type": "string"
        },
        "wildcard": {
          "default": "",
          "title": "Wildcard",
          "type": "string"
        }
      },
      "required": [
        "acl_name"
      ],
      "title": "ACLEntry",
      "type": "object"
    },
    "VLAN": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "vlan_id": {
          "maximum": 4094,
          "minimum": 1,
          "title": "Vlan Id",
          "type": "integer"
        },
        "vlan_name": {
          "title": "Vlan Name",
          "type": "string"
        }
      },
      "required": [
        "vlan_id",
        "vlan_name"
      ],
      "title": "VLAN",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "sites/<name>.yaml: the shared settings at the top level, plus VLANs and ACLs.\n\nInherits every GlobalSettings field and its checks, and like it rejects\nkeys it does not know, so a misspelt setting is reported rather than\nsilently replaced by its default.",
  "properties": {
    "aaa_fail_message": {
      "default": "",
      "title": "Aaa Fail Message",
      "type": "string"
    },
    "aaa_group_name": {
      "default": "TACACS_SERVERS",
      "title": "Aaa Group Name",
      "type": "string"
    },
    "aaa_key": {
      "default": "",
      "title": "Aaa Key",
      "type": "string"
    },
    "aaa_key_type": {
      "default": "0",
      "enum": [
        "0",
        "6",
        "7"
      ],
      "title": "Aaa Key Type",
      "type": "string"
    },
    "aaa_protocol": {
      "default": "tacacs+",
      "enum": [
        "tacacs+",
        "radius"
      ],
      "title": "Aaa Protocol",
      "type": "string"
    },
    "aaa_servers": {
      "items": {
        "type": "string"
      },
      "title": "Aaa Servers",
      "type": "array"
    },
    "acls": {
      "items": {
        "$ref": "#/$defs/ACLEntry"
      },
      "title": "Acls",
      "type": "array"
    },
    "banner_motd": {
      "default": "AUTHORISED ACCESS ONLY. Disconnect immediately if not authorised.",
      "title": "Banner Motd",
      "type": "string"
    },
    "dns_servers": {
      "items": {
        "type": "string"
      },
      "title": "Dns Servers",
      "type": "array"
    },
    "domain_name": {
      "default": "",
      "title": "Domain Name",
      "type": "string"
    },
    "enable_secret": {
      "default": "changeme",
      "title": "Enable Secret",
      "type": "string"
    },
    "local_password": {
      "default": "changeme",
      "title": "Local Password",
      "type": "string"
    },
    "local_username": {
      "default": "",
      "title": "Local Username",
      "type": "string"
    },
    "mgmt_subnet": {
      "default": "",
      "title": "Mgmt Subnet",
      "type": "string"
    },
    "ntp_servers": {
      "items": {
        "type": "string"
      },
      "title": "Ntp Servers",
      "type": "array"
    },
    "site_name": {
      "default": "",
      "title": "Site Name",
      "type": "string"
    },
    "snmp_auth_protocol": {
      "default": "SHA",
      "enum": [
        "SHA",
        "MD5"
      ],
      "title": "Snmp Auth Protocol",
      "type": "string"
    },
    "snmp_contact": {
      "default": "",
      "title": "Snmp Contact",
      "type": "string"
    },
    "snmp_host": {
      "default": "",
      "title": "Snmp Host",
      "type": "string"
    },
    "snmp_location": {
      "default": "",
      "title": "Snmp Location",
      "type": "string"
    },
    "snmp_priv_protocol": {
      "default": "AES",
      "enum": [
        "AES",
        "DES",
        "3DES"
      ],
      "title": "Snmp Priv Protocol",
      "type": "string"
    },
    "snmp_ro_acl": {
      "default": "ACL_SNMP_RO_ACCESS",
      "title": "Snmp Ro Acl",
      "type": "string"
    },
    "snmp_ro_auth_password": {
      "default": "",
      "title": "Snmp Ro Auth Password",
      "type": "string"
    },
    "snmp_ro_group": {
      "default": "SNMPv3_RO",
      "title": "Snmp Ro Group",
      "type": "string"
    },
    "snmp_ro_priv_password": {
      "default": "",
      "title": "Snmp Ro Priv Password",
      "type": "string"
    },
    "snmp_ro_user": {
      "default": "",
      "title": "Snmp Ro User",
      "type": "string"
    },
    "snmp_rw_acl": {
      "default": "ACL_SNMP_RW_ACCESS",
      "title": "Snmp Rw Acl",
      "type": "string"
    },
    "snmp_rw_auth_password": {
      "default": "",
      "title": "Snmp Rw Auth Password",
      "type": "string"
    },
    "snmp_rw_group": {
      "default": "SNMPv3_RW",
      "title": "Snmp Rw Group",
      "type": "string"
    },
    "snmp_rw_priv_password": {
      "default": "",
      "title": "Snmp Rw Priv Password",
      "type": "string"
    },
    "snmp_rw_user": {
      "default": "",
      "title": "Snmp Rw User",
      "type": "string"
    },
    "summer_time_config": {
      "default": "",
      "title": "Summer Time Config",
      "type": "string"
    },
    "syslog_server": {
      "items": {
        "type": "string"
      },
      "title": "Syslog Server",
      "type": "array"
    },
    "timezone": {
      "default": "",
      "title": "Timezone",
      "type": "string"
    },
    "vlans": {
      "items": {
        "$ref": "#/$defs/VLAN"
      },
      "title": "Vlans",
      "type": "array"
    },
    "vty_acl": {
      "default": "ACL_VTY_ACCESS",
      "title": "Vty Acl",
      "type": "string"
    }
  },
  "title": "SiteFile",
  "type": "object"
}
