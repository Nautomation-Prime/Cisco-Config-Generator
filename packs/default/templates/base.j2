{% set d = settings.defaults %}
{% set is_iosxe = 'C92' in device.model or 'C93' in device.model %}
! ============================================================
! Base Configuration
! Device  : {{ device.hostname }}
! Site    : {{ device.site | default('N/A', true) }}
! Model   : {{ device.model }}
! Generated by Cisco Config Generator - Nautomation Prime
! ============================================================
{% if not d.emit_crypto_key_command %}
!
! ------------------------------------------------------------
! POST-APPLY STEP - run from privileged EXEC, not config mode:
!
!   crypto key generate rsa label {{ d.ssh_key_label }} general-keys modulus {{ d.ssh_key_modulus }}
!
! 'crypto key generate rsa' is an EXEC command and is rejected in
! configuration mode. SSH will not start until the key pair exists.
! ------------------------------------------------------------
{% endif %}
!
{% if d.service_pad %}
service pad
{% else %}
no service pad
{% endif %}
service tcp-keepalives-in
service tcp-keepalives-out
service timestamps debug datetime msec localtime show-timezone
service timestamps log datetime msec localtime show-timezone
service password-encryption
{% if d.service_internal %}
service internal
{% endif %}
{% if d.service_compress_config %}
service compress-config
{% endif %}
{% if d.service_call_home %}
service call-home
{% else %}
no service call-home
{% endif %}
{% if is_iosxe %}
no platform punt-keepalive disable-kernel-core
{% endif %}
!
hostname {{ device.hostname }}
!
{% if is_iosxe %}
vrf definition Mgmt-vrf
 !
 address-family ipv4
 exit-address-family
 !
 address-family ipv6
 exit-address-family
!
{% endif %}
logging count
logging buffered {{ d.logging_buffer_size }}
logging rate-limit all 100
{% if d.logging_console_level %}
logging console {{ d.logging_console_level }}
{% else %}
no logging console
{% endif %}
logging monitor {{ d.logging_monitor_level }}
logging origin-id hostname
logging trap {{ d.logging_trap_level }}
!
{% for cause in d.errdisable_recovery_causes %}
errdisable recovery cause {{ cause }}
{% endfor %}
errdisable recovery interval {{ d.errdisable_recovery_interval }}
!
enable {{ global.enable_secret | cisco_secret(d.password_hash_type) }}
{% if global.local_username %}
username {{ global.local_username }} privilege {{ d.local_user_privilege }} {{ global.local_password | cisco_secret(d.password_hash_type) }}
{% endif %}
!
{% if features.aaa %}
{% set aaa = d.aaa %}
{% set group = global.aaa_group_name | default('TACACS_SERVERS', true) %}
aaa new-model
!
aaa authentication fail-message {{ d.aaa_fail_message_delimiter }}
{% if global.aaa_fail_message %}
{{ global.aaa_fail_message }}
{% else %}
  **************************- WARNING - ************************
  *                                                            *
  *   Your attempt to access this system/network has failed.   *
  *                                                            *
  *   If you are an unauthorized person, LOG OFF IMMEDIATELY   *
  *                                                            *
  *   Unauthorized access to this system/network is            *
  *                                                            *
  *   strictly prohibited!                                     *
  *                                                            *
  ************************* - WARNING - ************************
{% endif %}
{{ d.aaa_fail_message_delimiter }}
!
{% if global.aaa_servers %}
aaa group server {{ global.aaa_protocol }} {{ group }}
{% for server in global.aaa_servers %}
{% if global.aaa_protocol == 'radius' %}
 server-private {{ server }} auth-port {{ aaa.radius_auth_port }} acct-port {{ aaa.radius_acct_port }} key {{ global.aaa_key_type }} {{ global.aaa_key }}
{% else %}
 server-private {{ server }} key {{ global.aaa_key_type }} {{ global.aaa_key }}
{% endif %}
{% endfor %}
{% if aaa.source_interface %}
 ip {{ 'radius' if global.aaa_protocol == 'radius' else 'tacacs' }} source-interface Vlan{{ device.mgmt_vlan }}
{% endif %}
!
{% if aaa.prompts.password %}
aaa authentication password-prompt {{ aaa.prompts.password }}
{% endif %}
{% if aaa.prompts.username %}
aaa authentication username-prompt {{ aaa.prompts.username }}
{% endif %}
{% if aaa.authentication.login %}
aaa authentication login default {{ aaa.authentication.login | replace('{group}', group) }}
{% endif %}
{% if aaa.authentication.enable %}
aaa authentication enable default {{ aaa.authentication.enable | replace('{group}', group) }}
{% endif %}
{% if aaa.authorization.exec %}
aaa authorization exec default {{ aaa.authorization.exec | replace('{group}', group) }}
{% endif %}
{% if aaa.authorization_console %}
aaa authorization console
{% endif %}
{% for level in aaa.authorization.commands %}
aaa authorization commands {{ level }} default {{ aaa.authorization.commands_methods | replace('{group}', group) }}
{% endfor %}
{% if aaa.accounting.exec %}
aaa accounting exec default {{ aaa.accounting.exec | replace('{group}', group) }}
{% endif %}
{% for level in aaa.accounting.commands %}
aaa accounting commands {{ level }} default {{ aaa.accounting.commands_methods | replace('{group}', group) }}
{% endfor %}
{% if aaa.session_id %}
aaa session-id {{ aaa.session_id }}
{% endif %}
{% else %}
{% if aaa.local_only.login %}
aaa authentication login default {{ aaa.local_only.login }}
{% endif %}
{% if aaa.local_only.exec %}
aaa authorization exec default {{ aaa.local_only.exec }}
{% endif %}
{% endif %}
!
{% endif %}
clock timezone {{ device.timezone | default('GMT', true) }} {{ device.timezone_hours_offset | default(0, true) }} {{ device.timezone_minutes_offset | default(0, true) }}
{% if global.summer_time_config %}
clock summer-time {{ global.summer_time_config }}
{% endif %}
!
{% if is_iosxe %}
boot system flash:packages.conf
{% endif %}
no ip routing
!
{% if global.dns_servers %}
{% for dns in global.dns_servers %}
ip name-server {{ dns }}
{% endfor %}
{% endif %}
ip domain name {{ global.domain_name | default('local', true) }}
{% if d.domain_lookup %}
ip domain lookup
ip domain lookup source-interface Vlan{{ device.mgmt_vlan }}
{% else %}
no ip domain lookup
{% endif %}
!
{% if d.emit_crypto_key_command %}
crypto key generate rsa label {{ d.ssh_key_label }} general-keys modulus {{ d.ssh_key_modulus }}
{% endif %}
ip ssh version {{ d.ssh_version }}
ip ssh rsa keypair-name {{ d.ssh_key_label }}
ip ssh dh min size {{ d.ssh_dh_min_size }}
{% if d.ssh_encryption_algorithms %}
ip ssh server algorithm encryption {{ d.ssh_encryption_algorithms }}
{% endif %}
{% if d.ssh_mac_algorithms %}
ip ssh server algorithm mac {{ d.ssh_mac_algorithms }}
{% endif %}
{% if d.ssh_kex_algorithms %}
ip ssh server algorithm kex {{ d.ssh_kex_algorithms }}
{% endif %}
ip ssh time-out {{ d.ssh_timeout }}
ip ssh source-interface Vlan{{ device.mgmt_vlan }}
!
{% if features.dhcp_snooping %}
no ip dhcp snooping
no ip dhcp snooping vlan {{ d.dhcp_snooping_vlans }}
!
ip dhcp snooping
ip dhcp snooping vlan {{ d.dhcp_snooping_vlans }}
{% if d.dhcp_snooping_information_option %}
ip dhcp snooping information option
{% else %}
no ip dhcp snooping information option
{% endif %}
!
{% endif %}
login on-success log
login on-failure log
!
vtp mode off
udld enable
{% if is_iosxe %}
no device-tracking logging theft
{% endif %}
!
{% if is_iosxe %}
license boot level network-essentials addon dna-essentials
!
diagnostic bootup level complete
!
{% endif %}
{% if d.qos_enabled and not is_iosxe %}
! Global QoS must be on before any interface 'mls qos trust' takes effect.
mls qos
!
{% endif %}
{% if features.spanning_tree %}
spanning-tree mode {{ d.spanning_tree_mode }}
spanning-tree extend system-id
{% if d.spanning_tree_portfast_bpduguard_default %}
spanning-tree portfast bpduguard default
{% endif %}
!
{% endif %}
{% if is_iosxe %}
redundancy
 mode sso
!
{% endif %}
transceiver type all
 monitoring
!
{% if d.shutdown_vlan1 %}
! --- VLAN 1 Shutdown ---
interface Vlan1
 description * unused *
 no ip address
 shutdown
!
{% endif %}
! --- Management Interface ---
interface Vlan{{ device.mgmt_vlan }}
 description {{ device.site | default('Management', true) }} - Management
 ip address {{ device.mgmt_ip }} {{ device.mgmt_subnet | default('255.255.255.0', true) }}
 no shutdown
!
ip default-gateway {{ device.default_gateway }}
ip forward-protocol nd
no ip http server
no ip http secure-server
!
{% if global.syslog_server %}
{% for syslog in global.syslog_server %}
logging host {{ syslog }}
{% endfor %}
{% if d.logging_source_interface %}
logging source-interface Vlan{{ device.mgmt_vlan }}
{% endif %}
!
{% endif %}
{% if features.snmp and (global.snmp_ro_user or global.snmp_rw_user) %}
snmp-server view VIEWALL iso included
snmp-server trap link ietf
snmp ifmib ifindex persist
{% if global.snmp_ro_user %}
{% if features.acls and global.snmp_ro_acl %}
snmp-server group {{ global.snmp_ro_group | default('SNMPv3_RO', true) }} v3 priv read VIEWALL access {{ global.snmp_ro_acl }}
{% else %}
snmp-server group {{ global.snmp_ro_group | default('SNMPv3_RO', true) }} v3 priv read VIEWALL
{% endif %}
{% endif %}
{% if global.snmp_rw_user %}
{% if features.acls and global.snmp_rw_acl %}
snmp-server group {{ global.snmp_rw_group | default('SNMPv3_RW', true) }} v3 priv read VIEWALL write VIEWALL access {{ global.snmp_rw_acl }}
{% else %}
snmp-server group {{ global.snmp_rw_group | default('SNMPv3_RW', true) }} v3 priv read VIEWALL write VIEWALL
{% endif %}
{% endif %}
{% if global.snmp_location %}
snmp-server location {{ global.snmp_location }}
{% endif %}
{% if global.snmp_contact %}
snmp-server contact {{ global.snmp_contact }}
{% endif %}
{% if d.snmp_source_interface %}
snmp-server source-interface traps Vlan{{ device.mgmt_vlan }}
{% endif %}
snmp-server enable traps
{% set priv_suffix = (' ' ~ d.snmp_priv_aes_key_length) if global.snmp_priv_protocol | default('AES', true) | upper == 'AES' else '' %}
{% if global.snmp_ro_user %}
snmp-server user {{ global.snmp_ro_user }} {{ global.snmp_ro_group | default('SNMPv3_RO', true) }} v3 auth {{ global.snmp_auth_protocol | default('SHA', true) }} {{ global.snmp_ro_auth_password }} priv {{ global.snmp_priv_protocol | default('AES', true) }}{{ priv_suffix }} {{ global.snmp_ro_priv_password }}
{% endif %}
{% if global.snmp_rw_user %}
snmp-server user {{ global.snmp_rw_user }} {{ global.snmp_rw_group | default('SNMPv3_RW', true) }} v3 auth {{ global.snmp_auth_protocol | default('SHA', true) }} {{ global.snmp_rw_auth_password }} priv {{ global.snmp_priv_protocol | default('AES', true) }}{{ priv_suffix }} {{ global.snmp_rw_priv_password }}
{% endif %}
{% if global.snmp_host %}
snmp-server host {{ global.snmp_host }} version 3 priv {{ global.snmp_ro_user if global.snmp_ro_user else global.snmp_rw_user }}
{% endif %}
!
{% endif %}
line con 0
 exec-timeout {{ d.exec_timeout }}
{% if not features.aaa %}
 login local
{% endif %}
 logging synchronous
 escape-character {{ d.escape_character }}
 stopbits {{ d.console_stopbits }}
!
line vty 0 4
 exec-timeout {{ d.exec_timeout }}
{% if features.acls and global.vty_acl %}
 access-class {{ global.vty_acl }} in vrf-also
{% endif %}
{% if not features.aaa %}
 login local
{% endif %}
 length {{ d.vty_length }}
 logging synchronous
 transport input ssh
 escape-character {{ d.escape_character }}
!
line vty 5 15
 exec-timeout {{ d.exec_timeout }}
{% if features.acls and global.vty_acl %}
 access-class {{ global.vty_acl }} in vrf-also
{% endif %}
{% if not features.aaa %}
 login local
{% endif %}
 length {{ d.vty_length }}
 logging synchronous
 transport input ssh
 escape-character {{ d.escape_character }}
!
{% if features.ntp and global.ntp_servers %}
{% for ntp in global.ntp_servers %}
ntp {{ d.ntp_mode }} {{ ntp }}
{% endfor %}
{% if d.ntp_source_interface %}
ntp source Vlan{{ device.mgmt_vlan }}
{% endif %}
!
{% endif %}
{% if features.banner %}
banner motd {{ d.banner_delimiter }}
{{ global.banner_motd | default('AUTHORISED ACCESS ONLY. Disconnect immediately if not authorised.', true) }}
{{ d.banner_delimiter }}
!
{% endif %}
